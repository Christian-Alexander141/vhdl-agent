<mxfile host="drawio" version="24.0.0"><diagram id="t" name="1 Zeitleiste"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2510" pageHeight="680" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;b style='font-size:26px'&gt;Änderungsprotokoll – VHDL-Multiagentensystem&lt;/b&gt;&lt;br&gt;vom ersten Konzept (Sommer 2026) bis zum ersten Lauf ohne Reparatur (12.10.2026)" style="text;html=1;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="40" as="geometry"/></mxCell><mxCell id="t2" value="" style="ellipse;fillColor=#333333;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="148" width="4" height="4" as="geometry"/></mxCell><mxCell id="t3" value="" style="ellipse;fillColor=#333333;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2460" y="148" width="4" height="4" as="geometry"/></mxCell><mxCell id="t4" value="" style="endArrow=block;endFill=1;strokeWidth=4;strokeColor=#555555;" edge="1" parent="1" source="t2" target="t3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t5" value="&lt;b style='font-size:18px'&gt;0&lt;/b&gt;" style="ellipse;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=3;fontSize=16;" vertex="1" parent="1"><mxGeometry x="143.0" y="128" width="44" height="44" as="geometry"/></mxCell><mxCell id="t6" value="&lt;b&gt;Juli/Aug. 2026&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=bottom;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="250" height="40" as="geometry"/></mxCell><mxCell id="t7" value="&lt;div style='font-size:15px;font-weight:bold;margin-bottom:6px'&gt;💡 Konzepte&lt;/div&gt;&lt;ul style='margin:0;padding-left:16px;text-align:left'&gt;&lt;li style='margin-bottom:4px'&gt;Orchestrator mit Blackboard&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;Hermes + OpenCode in 🐳 Docker, LangChain, CrewAI&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;lokales Steuermodell (1–7 B)&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;Fehler → Prompt-Schleife&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;Lernspeicher memory.md&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;shadow=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="250" height="270" as="geometry"/></mxCell><mxCell id="t8" value="&lt;i&gt;📎 lagacy/Architekturüberblick.png&lt;br&gt;lagacy/Grapische_arch (S. 2)&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="478" width="250" height="40" as="geometry"/></mxCell><mxCell id="t9" value="" style="fillColor=#666666;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="164.0" y="172" width="2" height="28" as="geometry"/></mxCell><mxCell id="t10" value="&lt;b style='font-size:18px'&gt;1&lt;/b&gt;" style="ellipse;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=3;fontSize=16;" vertex="1" parent="1"><mxGeometry x="413.0" y="128" width="44" height="44" as="geometry"/></mxCell><mxCell id="t11" value="&lt;b&gt;02.08.2026&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=bottom;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="310" y="80" width="250" height="40" as="geometry"/></mxCell><mxCell id="t12" value="&lt;div style='font-size:15px;font-weight:bold;margin-bottom:6px'&gt;🚀 Erste lauffähige Version&lt;/div&gt;&lt;ul style='margin:0;padding-left:16px;text-align:left'&gt;&lt;li style='margin-bottom:4px'&gt;Ports-und-Adapter-Architektur&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;📚 RAG-Pipeline&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;Ollama + OpenCode&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;linearer Zustandsautomat:&lt;br&gt;ANALYZING → RAG_SEARCH → … → TESTING&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;ein Agentenlauf, noch kein MAS&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="200" width="250" height="270" as="geometry"/></mxCell><mxCell id="t13" value="&lt;i&gt;📎 bb5e68c · workflow.drawio&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="310" y="478" width="250" height="40" as="geometry"/></mxCell><mxCell id="t14" value="" style="fillColor=#6c8ebf;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="434.0" y="172" width="2" height="28" as="geometry"/></mxCell><mxCell id="t15" value="&lt;b style='font-size:18px'&gt;2&lt;/b&gt;" style="ellipse;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=3;fontSize=16;" vertex="1" parent="1"><mxGeometry x="683.0" y="128" width="44" height="44" as="geometry"/></mxCell><mxCell id="t16" value="&lt;b&gt;15.08.2026&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=bottom;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="580" y="80" width="250" height="40" as="geometry"/></mxCell><mxCell id="t17" value="&lt;div style='font-size:15px;font-weight:bold;margin-bottom:6px'&gt;🔧 GHDL-Simulation&lt;/div&gt;&lt;ul style='margin:0;padding-left:16px;text-align:left'&gt;&lt;li style='margin-bottom:4px'&gt;erzeugter Code wird automatisch simuliert&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;Grundlage der Reparaturschleife&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="200" width="250" height="270" as="geometry"/></mxCell><mxCell id="t18" value="&lt;i&gt;📎 45880f0&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="580" y="478" width="250" height="40" as="geometry"/></mxCell><mxCell id="t19" value="" style="fillColor=#6c8ebf;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="704.0" y="172" width="2" height="28" as="geometry"/></mxCell><mxCell id="t20" value="&lt;b style='font-size:18px'&gt;3&lt;/b&gt;" style="ellipse;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=3;fontSize=16;" vertex="1" parent="1"><mxGeometry x="953.0" y="128" width="44" height="44" as="geometry"/></mxCell><mxCell id="t21" value="&lt;b&gt;13.09.2026&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=bottom;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="850" y="80" width="250" height="40" as="geometry"/></mxCell><mxCell id="t22" value="&lt;div style='font-size:15px;font-weight:bold;margin-bottom:6px'&gt;🤖 Erster Durchlauf + MAS&lt;/div&gt;&lt;ul style='margin:0;padding-left:16px;text-align:left'&gt;&lt;li style='margin-bottom:4px'&gt;erstmals bis Vivado 🏭&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;7 Agenten: Supervisor, Architecture, HDL, Verification, Debug, FPGA, HardwareTest&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;Phasensteuerung durch den Supervisor&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="850" y="200" width="250" height="270" as="geometry"/></mxCell><mxCell id="t23" value="&lt;i&gt;📎 a37f1c3 · 7e20a4f&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="850" y="478" width="250" height="40" as="geometry"/></mxCell><mxCell id="t24" value="" style="fillColor=#6c8ebf;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="974.0" y="172" width="2" height="28" as="geometry"/></mxCell><mxCell id="t25" value="&lt;b style='font-size:18px'&gt;4&lt;/b&gt;" style="ellipse;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=3;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1223.0" y="128" width="44" height="44" as="geometry"/></mxCell><mxCell id="t26" value="&lt;b&gt;07.10.2026&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=bottom;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1120" y="80" width="250" height="40" as="geometry"/></mxCell><mxCell id="t27" value="&lt;div style='font-size:15px;font-weight:bold;margin-bottom:6px'&gt;🏗️ Großer Umbau&lt;/div&gt;&lt;ul style='margin:0;padding-left:16px;text-align:left'&gt;&lt;li style='margin-bottom:4px'&gt;RAG entfernt&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;Gates: Contracts, Abdeckung, Timing&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;TaskGraph, parallele Worker&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;Dashboard, ~40 Testdateien&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;Ollama: Name, Analyse, Diagnose&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;UART in jedem Projekt, Freigabe vor Flash&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="200" width="250" height="270" as="geometry"/></mxCell><mxCell id="t28" value="&lt;i&gt;📎 82431d7 · lagacy/aktuelle_arch&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1120" y="478" width="250" height="40" as="geometry"/></mxCell><mxCell id="t29" value="" style="fillColor=#9673a6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1244.0" y="172" width="2" height="28" as="geometry"/></mxCell><mxCell id="t30" value="&lt;b style='font-size:18px'&gt;5&lt;/b&gt;" style="ellipse;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=3;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1493.0" y="128" width="44" height="44" as="geometry"/></mxCell><mxCell id="t31" value="&lt;b&gt;08.–09.10.2026&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=bottom;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1390" y="80" width="250" height="40" as="geometry"/></mxCell><mxCell id="t32" value="&lt;div style='font-size:15px;font-weight:bold;margin-bottom:6px'&gt;📊 Messung MAS vs. OpenCode&lt;/div&gt;&lt;ul style='margin:0;padding-left:16px;text-align:left'&gt;&lt;li style='margin-bottom:4px'&gt;Benchmark mas_vs_single + small_vhdl_bench&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;Analyse #1–#19: Worker ohne Selbstprüfung, zerstückelter Kontext, UART überall …&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;GHDL-Selbstprüfung, Testbench-Regeln, UART nur bei Bedarf&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1390" y="200" width="250" height="270" as="geometry"/></mxCell><mxCell id="t33" value="&lt;i&gt;📎 73769ce · f746f15 · ff3c9b4&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1390" y="478" width="250" height="40" as="geometry"/></mxCell><mxCell id="t34" value="" style="fillColor=#d6b656;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1514.0" y="172" width="2" height="28" as="geometry"/></mxCell><mxCell id="t35" value="&lt;b style='font-size:18px'&gt;6&lt;/b&gt;" style="ellipse;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=3;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1763.0" y="128" width="44" height="44" as="geometry"/></mxCell><mxCell id="t36" value="&lt;b&gt;10.10.2026&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=bottom;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1660" y="80" width="250" height="40" as="geometry"/></mxCell><mxCell id="t37" value="&lt;div style='font-size:15px;font-weight:bold;margin-bottom:6px'&gt;🧪 Verifikation &amp; Ausdauer&lt;/div&gt;&lt;ul style='margin:0;padding-left:16px;text-align:left'&gt;&lt;li style='margin-bottom:4px'&gt;🐍 Referenzmodell (differentieller Test)&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;🧬 Mutationsanalyse&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;Ollama entfernt – nur noch OpenCode&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;Planwiederholung mit Korrektur&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;🪜 Eskalation statt Aufgeben&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1660" y="200" width="250" height="270" as="geometry"/></mxCell><mxCell id="t38" value="&lt;i&gt;📎 1baea08 · d6091af · #20–#27&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1660" y="478" width="250" height="40" as="geometry"/></mxCell><mxCell id="t39" value="" style="fillColor=#9673a6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1784.0" y="172" width="2" height="28" as="geometry"/></mxCell><mxCell id="t40" value="&lt;b style='font-size:18px'&gt;7&lt;/b&gt;" style="ellipse;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=16;" vertex="1" parent="1"><mxGeometry x="2033.0" y="128" width="44" height="44" as="geometry"/></mxCell><mxCell id="t41" value="&lt;b&gt;10.–11.10.2026&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=bottom;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1930" y="80" width="250" height="40" as="geometry"/></mxCell><mxCell id="t42" value="&lt;div style='font-size:15px;font-weight:bold;margin-bottom:6px'&gt;🛠️ Echte Läufe am Board&lt;/div&gt;&lt;ul style='margin:0;padding-left:16px;text-align:left'&gt;&lt;li style='margin-bottom:4px'&gt;📋 Einzelanforderungen + Abschlussprüfung&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;🚑 Vorfilter (Triage), Leitern je Herkunft&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;⛔→✅ Freigabe vor Flash entfernt&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;Board-Wissen nach Master-XDC&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;Generic-Vertrag, Befund der Reparatur&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;eigenes Git je Workspace, Zustand 1,27 MB → 0,1 MB&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1930" y="200" width="250" height="270" as="geometry"/></mxCell><mxCell id="t43" value="&lt;i&gt;📎 4a16216 · #28–#42&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1930" y="478" width="250" height="40" as="geometry"/></mxCell><mxCell id="t44" value="" style="fillColor=#b85450;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2054.0" y="172" width="2" height="28" as="geometry"/></mxCell><mxCell id="t45" value="&lt;b style='font-size:18px'&gt;8&lt;/b&gt;" style="ellipse;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;fontSize=16;" vertex="1" parent="1"><mxGeometry x="2303.0" y="128" width="44" height="44" as="geometry"/></mxCell><mxCell id="t46" value="&lt;b&gt;11.–12.10.2026&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=bottom;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="2200" y="80" width="250" height="40" as="geometry"/></mxCell><mxCell id="t47" value="&lt;div style='font-size:15px;font-weight:bold;margin-bottom:6px'&gt;🏁 Erster Lauf ohne Reparatur&lt;/div&gt;&lt;ul style='margin:0;padding-left:16px;text-align:left'&gt;&lt;li style='margin-bottom:4px'&gt;Top-Level an die Synthese (#44)&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;Vivado VHDL-2008, XDC nur Top-Level (#45)&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;led-patterns-display: 7 Module, 39 Anforderungen, Mutation 1,0, Timing ok, ⚡ geflasht&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;UML- und Ablaufdiagramme&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;📼 Lauf-Trajektorien außerhalb des Workspaces (#46)&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;🧮 4-Bit-CPU (Aufgabe 04): 2 Läufe ohne Reparatur, Board ok&lt;/li&gt;&lt;li style='margin-bottom:4px'&gt;kritischer Pfad zuerst, Prüfanleitung fürs Board (#48–#55)&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;shadow=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2200" y="200" width="250" height="270" as="geometry"/></mxCell><mxCell id="t48" value="&lt;i&gt;📎 63a4752 · 943b9dd · fbacfdc&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2200" y="478" width="250" height="40" as="geometry"/></mxCell><mxCell id="t49" value="" style="fillColor=#82b366;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2324.0" y="172" width="2" height="28" as="geometry"/></mxCell><mxCell id="t50" value="&lt;b style='font-size:15px'&gt;Legende&lt;/b&gt;" style="text;html=1;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="545" width="540" height="34" as="geometry"/></mxCell><mxCell id="t51" value="" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="581" width="34" height="22" as="geometry"/></mxCell><mxCell id="t52" value="Konzept" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="82" y="581" width="185" height="24" as="geometry"/></mxCell><mxCell id="t53" value="" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="270" y="581" width="34" height="22" as="geometry"/></mxCell><mxCell id="t54" value="Aufbau" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="312" y="581" width="185" height="24" as="geometry"/></mxCell><mxCell id="t55" value="" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="500" y="581" width="34" height="22" as="geometry"/></mxCell><mxCell id="t56" value="Umbau" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="542" y="581" width="185" height="24" as="geometry"/></mxCell><mxCell id="t57" value="" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="615" width="34" height="22" as="geometry"/></mxCell><mxCell id="t58" value="Messung / Analyse" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="82" y="615" width="185" height="24" as="geometry"/></mxCell><mxCell id="t59" value="" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="270" y="615" width="34" height="22" as="geometry"/></mxCell><mxCell id="t60" value="Korrekturen aus echten Läufen" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="312" y="615" width="185" height="24" as="geometry"/></mxCell><mxCell id="t61" value="" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="500" y="615" width="34" height="22" as="geometry"/></mxCell><mxCell id="t62" value="Erfolg / Dokumentation" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="542" y="615" width="185" height="24" as="geometry"/></mxCell><mxCell id="t63" value="&lt;b style='font-size:15px'&gt;Roter Faden&lt;/b&gt;&lt;br&gt;Aus einem Konzept mit vielen Frameworks und lokalem Steuermodell wurde schrittweise ein Supervisor mit festen Phasen und Gates, der nur noch OpenCode nutzt. Ab Oktober zeigten Messungen und echte Läufe am Board vor allem Fehler im System selbst (Verträge zwischen Agenten, Werkzeugaufrufe, verlorene Informationen). Nach deren Behebung lief am 11.10.2026 erstmals eine Aufgabe mit 7 Modulen ohne eine einzige Reparatur bis auf das Board." style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="545" width="1500" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c" name="2 Damals → Heute"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1120" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style='font-size:26px'&gt;Frühere Konzeption → Stand 12.10.2026&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Damals (lagacy/)&lt;/b&gt;" style="text;html=1;align=center;fontSize=15;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="260" y="80" width="460" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Heute&lt;/b&gt;" style="text;html=1;align=center;fontSize=15;fontColor=#2d7600;" vertex="1" parent="1"><mxGeometry x="820" y="80" width="520" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;🎛️ Steuerung&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="200" height