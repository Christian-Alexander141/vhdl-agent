ell neu erzeugen&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;einmal, mit Begründung&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;strokeWidth=2;shadow=1;spacing=6;" vertex="1" parent="1"><mxGeometry x="750" y="1090" width="280" height="60" as="geometry"/></mxCell><mxCell id="b28" value="&lt;b&gt;🔕 Vergleichstest abschalten&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;für diesen Lauf, mit Warnung&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;strokeWidth=2;shadow=1;spacing=6;" vertex="1" parent="1"><mxGeometry x="750" y="1170" width="280" height="60" as="geometry"/></mxCell><mxCell id="b29" value="&lt;b&gt;🔁 weiter bei Statischem Check&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7600;fontSize=13;strokeWidth=2;shadow=1;spacing=6;" vertex="1" parent="1"><mxGeometry x="750" y="1350" width="280" height="55" as="geometry"/></mxCell><mxCell id="b30" value="&lt;b&gt;⏭️ Nächste Stufe sofort&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;ohne Pipeline-Neustart, ohne erneute Synthese&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;strokeWidth=2;shadow=1;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1270" width="260" height="75" as="geometry"/></mxCell><mxCell id="b31" value="ja" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b5" target="b25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#2d7600;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b25" target="b29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1050" y="240"/><mxPoint x="1050" y="1377"/></Array></mxGeometry></mxCell><mxCell id="b33" value="ja" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b10" target="b26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b34" value="ja, Modell noch alt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=2;exitX=1;exitY=0.4;entryX=0;entryY=0.5;" edge="1" parent="1" source="b13" target="b27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b35" value="ja, Modell schon neu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=2;exitX=0.85;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="b13" target="b28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#2d7600;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;entryX=1;entryY=0.3;" edge="1" parent="1" source="b27" target="b29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="1120"/><mxPoint x="1040" y="1366"/></Array></mxGeometry></mxCell><mxCell id="b37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#2d7600;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b28" target="b29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b38" value="ja" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#2d7600;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b14" target="b29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b39" value="nein" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b14" target="b30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;dashed=1;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="b30" target="b9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="662"/></Array></mxGeometry></mxCell><mxCell id="b41" value="&lt;b style='font-size:14px'&gt;🪜 Eskalationsleitern&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Entwurf&lt;/b&gt; (Syntax, Simulation, Modell, Synthese, Timing, Anforderung verletzt)&lt;br&gt;1–2 gezielte Reparatur → 3–4 Modul neu → 5 Architektur → 6–7 Fallback-Modell → Mensch&lt;br&gt;&lt;br&gt;&lt;b&gt;Testbench / Abdeckung / REQ-Lücke&lt;/b&gt;&lt;br&gt;1–2 Reparatur → 3 Fallback-Modell → 4 Reparatur → Mensch&lt;br&gt;&lt;br&gt;&lt;b&gt;Anforderung fehlt im Plan&lt;/b&gt;&lt;br&gt;1–2 Plan ergänzen → 3 Fallback-Modell → 4 → Mensch&lt;br&gt;&lt;br&gt;&lt;b&gt;Werkzeug / Konfiguration&lt;/b&gt; (Constraints, Bitstream-Config)&lt;br&gt;1 Neubau ohne Sprachmodell → 2 Reparatur mit Vivado-Kontext → 3 Fallback-Modell → Mensch&lt;br&gt;&lt;br&gt;&lt;b&gt;Hardware / Infrastruktur&lt;/b&gt; (Board, Kabel, Werkzeug, Anbieter)&lt;br&gt;sofort Mensch&lt;br&gt;&lt;br&gt;&lt;i&gt;Modus standard (Benchmark): eine Reparatur je Fehler, Abbruch bei gleichem Fehler.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fillColor=#ffffff;strokeColor=#cccccc;rounded=1;" vertex="1" parent="1"><mxGeometry x="1085" y="100" width="350" height="420" as="geometry"/></mxCell><mxCell id="b42" value="&lt;b style='font-size:14px'&gt;📝 Befund der Reparatur&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;code&gt;reports/repair_verdict.json&lt;/code&gt;&lt;br&gt;Ursache:&lt;br&gt;• design – src/ korrigiert&lt;br&gt;• testbench – Testbench korrigiert&lt;br&gt;• reference_model – Modell legt PROMPT falsch aus&lt;br&gt;• generated_check – erzeugte Prüfung falsch&lt;br&gt;• toolchain – Ursache außerhalb des Projekts&lt;br&gt;• specification – PROMPT unklar → offene Frage" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fillColor=#ffffff;strokeColor=#cccccc;rounded=1;" vertex="1" parent="1"><mxGeometry x="1085" y="690" width="350" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
